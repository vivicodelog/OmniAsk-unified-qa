# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ---------- 文本 LLM：DeepSeek ----------
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 多模态 LLM：Qwen-VL（阿里云百炼）----------
# 申请：https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- MySQL 8.0（存放上传表格生成的临时表）----------
# 需先手动建库：CREATE DATABASE unified_qa CHARACTER SET utf8mb4;
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=qa_user
MYSQL_PASSWORD=改成你自己的密码
MYSQL_DATABASE=unified_qa
